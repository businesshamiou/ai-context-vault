#!/usr/bin/env bash
# Refuse un commit contenant un secret.
# Actif pour tout client Git : agent, humain, script.

set -u

VAULT_ROOT="$(git rev-parse --show-toplevel)"

# --- Muraille preflight (Mission 039) : remede unique, pas de contournement ---
STAMP="$VAULT_ROOT/.claude/.preflight_stamp.json"
PREFLIGHT_REFUS="REFUS : preflight absent, illisible ou perime. Remede : bash tools/session-preflight.sh"

if [ ! -f "$STAMP" ]; then
  echo "$PREFLIGHT_REFUS" >&2
  exit 1
fi
if ! grep -qE '"ready"[[:space:]]*:[[:space:]]*true' "$STAMP" 2>/dev/null; then
  echo "$PREFLIGHT_REFUS" >&2
  exit 1
fi
if [ -n "$(find "$STAMP" -mmin +1440 2>/dev/null)" ]; then
  echo "$PREFLIGHT_REFUS" >&2
  exit 1
fi

# Invocation via `bash "$SCRIPT"` dans les deux cas : le bit executable du
# fichier sur disque n'est pas fiable (mesure Mission 046, Windows/MSYS,
# noacl) et ne doit jamais decider si un controle s'enchaine ou saute.

# --- Gardien de reciprocite (garde-fou d'obsolescence, Mission 046 pour
# l'outil, Mission 071 pour ce cablage) : outil local au depot workshop-build,
# consomme ici par chemin relatif au workspace (depot frere), faute de
# mecanisme de distribution transverse pour un outil Python -- Decision
# 2026-08-24 D2/D7 ne couvre que les outils shell secrets/liens. Fragile si
# les deux depots ne sont pas co-localises en freres du meme workspace :
# signale, non corrige, par ce lot (Mission 071, etape 2). ---
GUARDRAIL="$VAULT_ROOT/../workshop-build/tools/check-obsolescence-guardrail.py"

if [ ! -f "$GUARDRAIL" ]; then
  echo "REFUS : garde-fou de reciprocite introuvable : $GUARDRAIL" >&2
  echo "Le controle ne peut pas verifier, il refuse." >&2
  exit 1
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "REFUS : uv introuvable, impossible d'executer le garde-fou de reciprocite." >&2
  exit 1
fi

uv run "$GUARDRAIL" || exit 1

# --- Gardien de fraicheur des index (Mission 089) : un index faux est une
# cause de lien faux, verifie avant check-links.sh. Ne regenere jamais,
# ne verifie que les .md stages et les dossiers indexes qu'ils touchent. ---
INDEXES_CHECK="$VAULT_ROOT/tools/check-indexes-fresh.sh"

if [ ! -f "$INDEXES_CHECK" ]; then
  echo "REFUS : garde-fou de fraicheur des index introuvable : $INDEXES_CHECK" >&2
  echo "Le controle ne peut pas verifier, il refuse." >&2
  exit 1
fi

bash "$INDEXES_CHECK" || exit 1

CHECK="$VAULT_ROOT/tools/check-secrets.sh"

if [ ! -f "$CHECK" ]; then
  echo "REFUS : controle de secrets introuvable : $CHECK" >&2
  echo "Le controle ne peut pas verifier, il refuse." >&2
  exit 1
fi

bash "$CHECK" || exit 1

LINKS_CHECK="$VAULT_ROOT/tools/check-links.sh"

if [ ! -f "$LINKS_CHECK" ]; then
  echo "REFUS : controle de liens introuvable : $LINKS_CHECK" >&2
  echo "Le controle ne peut pas verifier, il refuse." >&2
  exit 1
fi

bash "$LINKS_CHECK" || exit 1

# --- Gardien des chemins affirmes (Mission 076 pour l'outil, Mission 103
# pour ce cablage) : corpus ramene a zero defaut avant cablage (Missions
# 091-102), aucun mecanisme d'exception necessaire. ---
ASSERTED_PATHS_CHECK="$VAULT_ROOT/tools/check-asserted-paths.sh"

if [ ! -f "$ASSERTED_PATHS_CHECK" ]; then
  echo "REFUS : garde-fou des chemins affirmes introuvable : $ASSERTED_PATHS_CHECK" >&2
  echo "Le controle ne peut pas verifier, il refuse." >&2
  exit 1
fi

bash "$ASSERTED_PATHS_CHECK" || exit 1

# --- Gardien du manifeste de distribution (Mission 110 pour ce cablage,
# DECISION-2026-08-29-153503 point 6 pour la decision de cablage). ---
MANIFEST_CHECK="$VAULT_ROOT/tools/check-distribution-manifest.sh"

if [ ! -f "$MANIFEST_CHECK" ]; then
  echo "REFUS : gardien du manifeste de distribution introuvable : $MANIFEST_CHECK" >&2
  echo "Le controle ne peut pas verifier, il refuse." >&2
  exit 1
fi

bash "$MANIFEST_CHECK" || exit 1
exit 0
